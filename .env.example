# --- PayPal (sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Freelancer's sandbox BUSINESS account email: the payee on every order.
PAYPAL_PAYEE_EMAIL=
# "override" (payee.email_address on the order) or "self" (fallback: the freelancer's own REST credentials make the calls)
PAYPAL_PAYEE_MODE=override
# Demo only: pre-fill this sandbox buyer email on the PayPal login screen.
PAYPAL_PREFILL_BUYER_EMAIL=
# 1 = use the built-in PayPal stand-in instead of the sandbox (no credentials needed; for local dev/tests only)
FAKE_PAYPAL=0

# --- LLM. Empty key = deterministic fallbacks for all three AI workflows. ---
# Gemini (default): free key from https://aistudio.google.com -> Get API key.
# Comma-separated LLM_MODEL = fallbacks when a model is overloaded. Uses the Interactions API;
# LLM_GEMINI_API=generatecontent selects the older endpoint. LLM_PROVIDER=anthropic uses Claude.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite,gemma-4-26b-a4b-it,gemini-3.5-flash
# Free tier has per-minute and per-day limits per model (gemini-3.5-flash: 20/day); e.g. 4000 spaces calls 4 s apart. 429s are retried automatically.
LLM_MIN_INTERVAL_MS=0

# --- Verifier worker ---
WORKER_URL=http://localhost:3002
WORKER_JOB_SECRET=change-me
# Exact hostnames of the deliverables (no suffix matching). The two demo-site hosts.
ALLOWED_HOSTS=
# DEV ONLY: exact origins that bypass https/443/private-IP rules (local demo sites + local inbox). Leave empty in production.
DEV_LOCAL_ORIGINS=http://localhost:5174,http://localhost:3001
DEMO_SITE_URLS=http://localhost:5174/broken/,http://localhost:5174/fixed/

# --- Backend ---
PUBLIC_BASE_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Optional: require this code on the demo login screen when hosted publicly
DEMO_LOGIN_CODE=
