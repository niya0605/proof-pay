FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY api/package.json api/
COPY worker/package.json worker/
COPY web/package.json web/
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci
COPY api api
COPY web web
RUN npm -w web run build
ENV PORT=3001 DB_FILE=/data/proofpay.db ARTIFACTS_DIR=/data/artifacts NODE_ENV=production
# Run as the image's unprivileged "node" user; it owns only the data volume.
RUN mkdir -p /data/artifacts && chown -R node:node /data
USER node
VOLUME /data
EXPOSE 3001
CMD ["npx", "-w", "api", "tsx", "src/server.ts"]
